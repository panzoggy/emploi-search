# Copié en backend/.env par start.sh au premier lancement, qui génère aussi DATA_KEY.

# Clé de chiffrement des CV (32 octets en base64). Sans elle, l'API refuse de démarrer.
# Pour en créer une à la main : openssl rand -base64 32
# Ne la perds pas : sans elle, les CV enregistrés sont illisibles.
DATA_KEY=

# Si défini, il faut ce code pour créer un compte. Indispensable dès que l'app est ouverte sur Internet.
SIGNUP_CODE=

# Niveau de logs : debug, info, warn, error
LOG_LEVEL=info

# Hors Docker uniquement (développement) : base SQLite locale. Dans Docker, docker-compose.yml la remplace.
DATABASE_URL=file:./dev.db
