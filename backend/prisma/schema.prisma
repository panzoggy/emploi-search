generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  searches     Search[]
  jobViews     JobView[]
  jobRejections JobRejection[]
  preferences  UserPreferences?
}

model UserPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords        String[] @default([])
  locations       String[] @default([])
  contractTypes   String[] @default([])
  remoteOnly      Boolean  @default(false)
  salaryMin       Int?
  salaryMax       Int?
  experienceLevel String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Search {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query       String
  location    String
  filters     Json     @default("{}")
  results     Job[]    @relation("SearchResults")
  createdAt   DateTime @default(now())
}

model Job {
  id              String   @id @default(cuid())
  externalId      String
  source          JobSource
  title           String
  company         String
  location        String
  description     String   @db.Text
  url             String   @unique
  salaryMin       Int?
  salaryMax       Int?
  contractType    String?
  experienceLevel String?
  remoteType      String?
  postedAt        DateTime?
  scrapedAt       DateTime @default(now())
  searchId        String?
  search          Search?  @relation("SearchResults", fields: [searchId], references: [id], onDelete: SetNull)
  views           JobView[]
  rejections      JobRejection[]
  
  @@unique([externalId, source])
  @@index([source])
  @@index([postedAt])
  @@index([company])
}

model JobView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())
  duration  Int?     // in seconds
  
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model JobRejection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rejectedAt  DateTime @default(now())
  reason      String?
  
  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model ScrapingLog {
  id        String   @id @default(cuid())
  source    JobSource
  query     String
  location  String
  status    ScrapingStatus
  jobsFound Int      @default(0)
  error     String?  @db.Text
  startedAt DateTime @default(now())
  finishedAt DateTime?
}

enum JobSource {
  INDEED
  HELLOWORK
  LINKEDIN
}

enum ScrapingStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}