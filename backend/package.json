{
  "name": "backend",
  "version": "1.0.0",
  "description": "API EmploiSearch : collecte des offres, profil, matching",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@prisma/client": "^5.10.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright-core": "1.63.0",
    "prisma": "^5.10.0",
    "unpdf": "1.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "2.2.0",
    "@types/node": "^20.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.26.0"
}
