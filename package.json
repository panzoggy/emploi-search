{
  "name": "emploi-search",
  "version": "1.0.0",
  "description": "Recherche d'emploi : collecte HelloWork, Indeed et LinkedIn, classement selon le profil",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm -C backend dev\" \"pnpm -C frontend dev\"",
    "dev:backend": "pnpm -C backend dev",
    "dev:frontend": "pnpm -C frontend dev",
    "build": "pnpm -C backend build && pnpm -C frontend build",
    "db:generate": "pnpm -C backend db:generate",
    "db:studio": "pnpm -C backend db:studio",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm -C backend db:migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.26.0"
}
